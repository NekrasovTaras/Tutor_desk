# Для первого запуска ничего менять не нужно: SQLite создаётся автоматически.
# DATABASE_URL=sqlite:///./data/tutordesk.db

# PostgreSQL из compose.yaml (при запуске Python на вашем компьютере):
# DATABASE_URL=postgresql+psycopg://tutordesk:local_dev_password@localhost:5432/tutordesk

# true — только при публикации за HTTPS; для localhost оставьте false.
COOKIE_SECURE=false
